package Funcoes_Metodos_10;

public class Exercicio_8 {
	
	public static String contaVorgais(String texto) {
		int quant = 0;
		
		for(char c : texto.toCharArray()) {
			
			
			
			if("aeiou".indexOf(c) != -1);
			
			quant++;
			

		}

		return "Quantidade de vorgais em " + texto + "é de : "+ quant;
		
	}

	public static void main(String[] args) {
		
		System.out.println(contaVorgais("AMONGUS"));

	}

}
