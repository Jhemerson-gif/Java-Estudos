package Listas;
import java.util.ArrayList;
import java.util.Scanner;
import java.util.Arrays;

public class Lista_Exercicio_1 {

	public static void main(String[] args) {
		
		System.out.println("Exercicio 1: Cadastrando Nomes");
		
		ArrayList<String> nomes = new ArrayList<>(Arrays.asList());
		
		Scanner sc = new Scanner(System.in);
		
		String novosnomes;
		
		while(true) {
		
		System.out.println("Digite o nome: ");
		
		novosnomes = sc.nextLine();
		
		if ( novosnomes.equals("sair")) {
			break;
		}
		
		nomes.add(novosnomes);
		

		}
		
		System.out.println("Lista dos nomes digitados: ");
		
		for(int i = 0; i < nomes.size(); i++) {
			
			System.out.println((i+1)+ (". ")+ nomes.get(i));
		}
	}

}
