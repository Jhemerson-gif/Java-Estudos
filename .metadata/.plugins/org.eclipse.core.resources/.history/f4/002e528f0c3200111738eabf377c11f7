package Desafios;

import java.util.Scanner;

import java.util.ArrayList;

public class Sistema_de_notas_em_Java2 {
	
	public static double calcularMedia(double[] notas) { // Função média

		double soma = 0;
		
		for (int i = 0; i < notas.length; i++) {
			soma+= notas[i];
		
		}
		
		return soma / notas.length;
		
	}
	
	public static void alunoAprovadoReprovado(String nomes, double[] notas) { // função de avaliação do aluno
		double media = calcularMedia(notas);
		
		if (media > 7) {
			
			System.out.println("O aluno "+ nomes + " foi aprovado com a nota: "+ media);
		}else {
			
			System.out.println("O aluno "+ nomes + " foi reprovado com a nota: "+ media);
		}
		
	}
	
	public static double Maior(double[] notas) { // função de maior nota
		double maior = 0;
		for (int i = 1; i < notas.length; i++) {
			
			
			
			
			if (notas[i] > maior) {
				
				maior = notas[i];
				
			}
			
			
		}
		return maior;	
		
	}
	public static double Menor(double[] notas) { // função de menor nota
		
		double menor = 0;
		for(int i =1; i < notas.length; i++) {
		
			
			if ( notas[i] > menor) {
			
			menor = notas[i];
			}
		}
		
		return menor;
	}	
	
	
	public static void main(String[] args) {
		
		String[] nomes = new String[5];
		
		Double[] notas = new notas[5];
		double maior  = 0;
		
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Sistema de Notas de Alunos em Java");
		
		for(int i = 0; i < 3; i++) { // loop  das informações da  array
			
			System.out.print("Digite seu nome: "+(i +1)+ ":");
			
			nomes[i] =sc.nextLine();
			
			System.out.print("Digite a primeira nota:  "+ (i+1) + ":");
		
			notas[i] = sc.nextDouble();
			
			sc.nextLine();
			
			System.out.println("-------------------------------");
			
		}
		
		
		double media = calcularMedia(notas);
		int maior = maior(notas);
		int menor = menor(notas);
		

		System.out.println("----------------RESULTADO DOS NOSSO ALUNOS ---------------"); // Maior e menor nota
		
		System.out.println("A media da turma foi: "+ media);
		
		System.out.println("A maior nota foi: "+ maior);
		System.out.println("A menor nota foi: "+ menor);
		
		System.out.println("\n Alunos aprovados ou reprovados: ");
		
		for(int i = 0; i < 5; i++) {
			
			System.out.println(nomes[i]+ "Nota: "+ notas[i] + alunoAprovadoReprovado(notas[i]));
			
		}
		
	sc.close();
		
		

	
	

	

}
