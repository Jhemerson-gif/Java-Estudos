package Array;

public class Array_Exemplo_4 {

	public static void main(String[] args) {
		
		int[] vetor  = {7,3,5,7,2,7,8,1,7,6};
		
		int contador = 0;
		
		for ( int valor: vetor) {
			
			if (valor == 7) {
				
				contador ++;
				System.out.println("O valor aparece: "+ contador+ " vezes.");
			}
		}
		System.out.println("O  valor 7  aparece um total de "+ contador + "v ezes.");

	}

}
