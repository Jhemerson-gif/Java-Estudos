package Listas;

import java.util.ArrayList;
import java.util.Scanner;

public class Lista_Exercicio_5 {

	public static void main(String[] args) {
		
		System.out.println("Exercício 5: Remover nomes duplicados: ");
		
		Scanner sc = new Scanner(System.in);
		
		ArrayList<String> nomes = new ArrayList<>();
		
		ArrayList<String> nomesunicos = new ArrayList<>();
		
		
		
		
		for(int i = 0; i < 5; i ++) {
			
			System.out.print((i+1) + ". Digite o nome: ");
			String nome = sc.nextLine();
			nomes.add(nome);
			
		}
		
		for(String nome : nomes ) {
		
			if(!nomesunicos.contains(nome)) {
				nomesunicos.add(nome);
			
			}
		}
		System.out.println("\nLista de nomes sem repetição");
		
		for (String nome : nomesunicos) {
			
			System.out.println("- " + nome);
		
		}
		
		
	}
	

}
