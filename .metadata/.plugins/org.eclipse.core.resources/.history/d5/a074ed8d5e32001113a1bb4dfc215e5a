package Desafios;

import java.util.Scanner;

public class Desafio_2 {

	public static double totalVendas(double[] vendas) { // soam total dos preços
		int soma = 0;
		for (int i = 0; i < vendas.length; i++) {
			
			soma += vendas[i];
			
		}
		
		return soma;
		
	}
	
	public static double maisCaro(double[] precos) { // o produto mais caro
		int maior = 0;
		for(int i =0; i < precos.length; i++) {
			
		
			if (precos[i] > precos[maior]) {
				
				precos[maior] = i;
				
			}
		}
		return maior;
		
	}
	
	public static double maisBarato(double[] precos) { // o produto mais barato
		
		int barato = 0;
		
		for (int i = 0; i < precos.length; i++) {
			
			
			if (precos[i] < precos[barato]) {
				
				precos[barato] = i;
			}
		}
		return barato;
	
	}
	
	public static double desconto10(double[] precos) { // produtos com desconto de 10% acima de 100 reais
		double desconto = 0.10;
		double valor = 0;
		for (int i =0; i< precos.length; i++) {
			
				precos[i] /= desconto;
				valor = precos[i] - desconto;
				
			
		}
		
		return valor;
		
	}
	
	
	
	public static void main(String[] args) {
		
		System.out.println("\nSistema de Vendas em Java");
		
		String[]produto = new String [5];
		double[]precos  = new double [5];
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("\n---------- BEM VINDO A WEB STORE ----------");
		
		System.out.println("\nVamos cadastrar os seus produtos para seu mostruario !");
		
		for (int i = 0; i < 5; i++) { // Cadastro dos produtos e preços
			
			System.out.print("Digite o nome do produto "+ (i+1) +":" );
			produto[i] = sc.nextLine();
			
			System.out.print("Digite o preço do produto: ");
			precos[i] = sc.nextDouble();
			
			sc.nextLine(); // limpar o buffer
		}
		
		
		System.out.println("---------- PRODUTOS CADASTRADOS ----------");
		
		System.out.println("O total  em valores dos produtos cadastrado é: "+ totalVendas(precos));
		
		System.out.println("O produto com preço mais alto: "+ maisCaro(precos));
		
		System.out.println("O produto com o preço mais barato: "+ maisBarato(precos));
		
		
		for (int i = 0 ; i < 5 ; i++) {
			
			if (precos[i] > 100) {
				
				System.out.println("O produto "+ produto[i] + " de valor "+ precos[i] + "com o deconto de 10% está custando: "+ desconto10(precos) );
			}else {
				
				System.out.println("O produto "+ produto[i] +"está custando: "+ precos[i]);
				
			}
		}

	}

}
