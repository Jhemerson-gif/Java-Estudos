package Set;

import java.util.Scanner;
import java.util.Set;
import java.util.HashSet;
import java.util.TreeSet;

public class Set_Exercicio_2 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		Set<Integer> sorteio = new TreeSet<>();
		
		System.out.println("Bem vindo a Loteria Amongus, digite 6 numeros");
		
		do{
		
			System.out.print("Digite o numero: ");
			int numeros = sc.nextInt();
			
			if(sorteio.contains(numeros) | numeros < 60 | numeros > 1) {
				
				System.out.println("Numero repertido digite novamente !");
			}else {
				
				System.out.println("Numero adicionaod com sucesso!");
			}
		}while(sorteio.size() < 6);
		

	}

}
