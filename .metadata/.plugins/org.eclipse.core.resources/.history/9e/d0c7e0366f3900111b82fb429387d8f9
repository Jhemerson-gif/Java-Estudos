package Funcoes_Metodos_10;

public class Exercicio_9 {

	public static int contaAte(int num) {
		
		for(int i = 1; i < num; i++) {
			if(i < num) {
				System.out.print(i + ", ");
			}
			
			if(i == num) {
				
				System.out.println(i + ". Fim do programa");
			}
		}
		
		return i;
	}
	
	public static void main(String[] args) {
		
		System.out.println(contaAte(100));

	}

}
