package Set;

import java.util.Scanner;
import java.util.HashSet;
import java.util.Set;

public class Set_Exemplo_2_Menu_Interativo {

	public static void main(String[] args) {
		
		Set<String> cojunto = new HashSet<>();
		
		Scanner sc = new Scanner(System.in);
		
		int opcao;
		
		do {
			
			System.out.println("\n===== MENU SET ======");
			
			System.out.println("1. Adicionar elemento");
			System.out.println("2. Remover elemento");
			System.out.println("3. Editar elemento");
			System.out.println("4. Listar todos os elemento");
			System.out.println("5. Limpar cojuntos");
			System.out.println("0. Sair");
			
			System.out.print("\nEscolha uma opção: ");
			
			opcao = sc.nextInt();
			
			sc.nextLine();
			
			switch (opcao) {
			
				case 1:
					
					System.out.println("Digite o elemento para adicionar: ");
					
					String novo = sc.nextLine();
					
					if (cojunto.add(novo)) {
						
						System.out.println("Elemento adicionado com sucesso!");
					}else {
						
						System.out.println("Elemento já existe no cojunto!");
					}
					break;
					
				case 2:
					
					System.out.println("Digite o numero do elemento que deseja remover: ");
					int remove = sc.nextInt();
					
					if (cojunto.remove(remove)) {
						
						System.out.println("Elemento removido com sucesso!");
					}else {
						
						System.out.println("Não existe o elemento dentro do cojunto!");
					}
					break;
					
				case 3:
					
					System.out.println("Digite o elemento do cojunto deseja editar: ");
					
					String editar = sc.nextLine();
					
					if(cojunto.contains(editar)) {
						
						System.out.println("Digite o nome do elemento: ");
						
						String novoValor = sc.nextLine();
						
						cojunto.remove(editar);
						cojunto.add(novoValor);
						
						System.out.println("Elemento editado com sucesso!");
						
					}else {
						
						System.out.println("Elemento não encontrado !");
					}
					
					break;
					
				case 4:
					if(cojunto.isEmpty()) {
						
						System.out.println("O cojunto está vazio.");
					}else {
					
					System.out.println("Este são todos os elementos do conjunto: " + cojunto);
					
					
					}
					break;
					
				case 5: 
					if (cojunto.isEmpty()) {
						
						System.out.println("O cojunto já estava vazio.");
					}else {
					
					System.out.println("Todos os "+ cojunto.size() +  " elementos do cojuntos foram removidos;");
					
					cojunto.clear();
					
					}
					break;
					
				case 0:
					
					System.out.println("Encerrando programa...");
					
					break;
					
				default:
					
					System.out.println("Opção invalida! Tente novamente.");
			}
			
		} while(opcao != 0);
		sc.close();

	}

}
